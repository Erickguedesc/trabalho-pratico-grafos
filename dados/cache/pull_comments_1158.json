scharging_symbol)),\n+                        battery::State::Unknown => Some(Ok(config.unknown_symbol)),\n+                        battery::State::Empty => Some(Ok(config.empty_symbol)),\n+                        _ => {\n+                            log::debug!(\"Unhandled battery state `{}`\", state);\n+                            None\n+                        }\n+                    },",
