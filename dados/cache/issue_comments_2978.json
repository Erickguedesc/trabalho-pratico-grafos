    "user": {
      "login": "chipbuster",
      "id": 4605384,
      "node_id": "MDQ6VXNlcjQ2MDUzODQ=",
      "avatar_url": "https://avatars.githubusercontent.com/u/4605384?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/chipbuster",
      "html_url": "https://github.com/chipbuster",
      "followers_url": "https://api.github.com/users/chipbuster/followers",
      "following_url": "https://api.github.com/users/chipbuster/following{/other_user}",
      "gists_url": "https://api.github.com/users/chipbuster/gists{/gist_id}",
