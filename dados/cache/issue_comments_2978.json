      "subscriptions_url": "https://api.github.com/users/chipbuster/subscriptions",
      "organizations_url": "https://api.github.com/users/chipbuster/orgs",
      "repos_url": "https://api.github.com/users/chipbuster/repos",
      "events_url": "https://api.github.com/users/chipbuster/events{/privacy}",
