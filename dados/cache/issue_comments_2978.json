  {
    "url": "https://api.github.com/repos/starship/starship/issues/comments/905719438",
    "html_url": "https://github.com/starship/starship/issues/2978#issuecomment-905719438",
    "issue_url": "https://api.github.com/repos/starship/starship/issues/2978",
    "id": 905719438,
