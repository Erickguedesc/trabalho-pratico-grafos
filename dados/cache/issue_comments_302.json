      "following_url": "https://api.github.com/users/chipbuster/following{/other_user}",
      "gists_url": "https://api.github.com/users/chipbuster/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/chipbuster/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/chipbuster/subscriptions",
