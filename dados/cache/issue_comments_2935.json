  {
    "url": "https://api.github.com/repos/starship/starship/issues/comments/1287804863",
    "html_url": "https://github.com/starship/starship/issues/2935#issuecomment-1287804863",
    "issue_url": "https://api.github.com/repos/starship/starship/issues/2935",
    "id": 1287804863,
    "node_id": "IC_kwDOCqswNs5Mwle_",
    "user": {
      "login": "Kissaki",
      "id": 93181,
      "node_id": "MDQ6VXNlcjkzMTgx",
      "avatar_url": "https://avatars.githubusercontent.com/u/93181?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/Kissaki",
      "html_url": "https://github.com/Kissaki",
