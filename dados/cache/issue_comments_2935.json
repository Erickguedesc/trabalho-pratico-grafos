      "gists_url": "https://api.github.com/users/Kissaki/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/Kissaki/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/Kissaki/subscriptions",
      "organizations_url": "https://api.github.com/users/Kissaki/orgs",
      "repos_url": "https://api.github.com/users/Kissaki/repos",
      "events_url": "https://api.github.com/users/Kissaki/events{/privacy}",
