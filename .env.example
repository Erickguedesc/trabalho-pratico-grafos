# Token único (5.000 req/h). Para maior velocidade, use múltiplos tokens separados por vírgula:
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx
# GITHUB_TOKENS=ghp_token1,ghp_token2,ghp_token3
OWNER=nome-do-dono
REPO=nome-do-repositorio
OUTPUT_DIR=/dados
INPUT_DIR=/dados

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=senha123