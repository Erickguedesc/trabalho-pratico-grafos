@startuml diagrama-visao-geral

title Trabalho de grafos — visão geral (contrato)

skinparam classAttributeIconSize 0
left to right direction

package "codigo/mineirador" as mineirador {
  class GitHubMinerador {
    + run() : Path
  }
  class GitHubClient {
  }
  class CacheJson {
    + get(key : str) : Any
    + set(key : str, data : Any) : void
  }
  class Interaction <<DTO>>
}

package contrato {
  artifact "interacoes.json" as InteracoesJson <<file>> {
  }
}

package "biblioteca/builder" as construtor {
  class UserMapper <<planned>>
  class GraphBuilder <<planned>> {
    + build(rows : list[Interaction]) : GraphBundle
  }
  class GraphBundle <<planned>> {
    + comments : AbstractGraph
    + issue_closes : AbstractGraph
    + pr_events : AbstractGraph
    + integrated : AbstractGraph
  }
}

package "biblioteca/graph" as grafo {
  abstract class AbstractGraph {
    + addEdge(u : int, v : int) : void
    + exportToGEPHI(path : str) : void
  }
  class AdjacencyMatrixGraph
  class AdjacencyListGraph
}

package "biblioteca/analysis" as analise {
  class GraphAnalyzer <<planned>> {
    + density(g : AbstractGraph) : float
    + pagerank(g : AbstractGraph) : dict[int, float]
  }
}

package "codigo/app" as demo {
  class DemoCLI <<planned>> {
    + main() : void
  }
}

class "urllib" as Urllib <<library>>
class "json" as JsonLib <<library>>

GitHubMinerador *-- GitHubClient
GitHubMinerador *-- CacheJson
GitHubClient ..> Urllib
CacheJson ..> JsonLib
GitHubMinerador ..> Interaction : «create»
GitHubMinerador ..> InteracoesJson : «write»

GraphBuilder ..> InteracoesJson : «read»
GraphBuilder ..> Interaction : «parse»
GraphBuilder ..> UserMapper
GraphBuilder ..> AbstractGraph : «create»

AbstractGraph <|-- AdjacencyMatrixGraph
AbstractGraph <|-- AdjacencyListGraph

GraphAnalyzer ..> AbstractGraph : «read»
DemoCLI ..> AbstractGraph
DemoCLI ..> GraphBuilder
DemoCLI ..> GitHubMinerador
DemoCLI ..> GraphAnalyzer

note bottom of grafo
  **Implementado** — API completa sem libs de grafos prontas.
end note

note bottom of mineirador
  **Implementado** — mineração e cache JSON.
end note

@enduml
