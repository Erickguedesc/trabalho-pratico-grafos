  }
}

package construtor {
  class UserMapper {
    + id_for(login) : int
    + login_for(id) : str
    + ...
  }
  class GraphBuilder {
    + build(rows) : GraphBundle
    + ...
  }
  class GraphBundle {
    + comments : AbstractGraph
    + issue_closes : AbstractGraph
    + pr_events : AbstractGraph
    + integrated : AbstractGraph
    + ...
  }
}

package grafo {
  abstract class AbstractGraph {
    + addEdge(u, v)
